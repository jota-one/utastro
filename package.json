{
  "name": "ut-astro",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db": "cd pb && ./pocketbase serve --http=127.0.0.1:8091",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --write",
    "migrate:down": "cd pb && ./pocketbase migrate down",
    "migrate:up": "cd pb && ./pocketbase migrate up",
    "pb:build": "cd pb-tools && go build -o ../pb/pb-custom",
    "pb:import-all": "cd pb && ./pb-custom import-all-data",
    "ut:import-users": "cd pb && ./pb-custom import-users"
  },
  "dependencies": {
    "@astrojs/node": "^10.1.1",
    "@astrojs/vue": "^6.0.1",
    "@hcaptcha/vue3-hcaptcha": "^1.3.0",
    "@jota-one/i36n": "^3.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@vueuse/core": "^14.3.0",
    "astro": "^6.3.8",
    "element-plus": "^2.14.0",
    "pocketbase": "^0.27.0",
    "tailwindcss": "^4.3.0",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "postcss": "^8.5.15",
    "postcss-custom-media": "^12.0.1",
    "typescript": "^6.0.3"
  },
  "volta": {
    "node": "24.11.1"
  }
}
