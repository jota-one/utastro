{
  "name": "ut-astro",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db": "cd pb && ./pocketbase serve --http=127.0.0.1:8091",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "bash tests/e2e/run.sh",
    "test:e2e:ui": "bash tests/e2e/run.sh --ui",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --write",
    "migrate:down": "cd pb && ./pocketbase migrate down",
    "migrate:up": "cd pb && ./pocketbase migrate up",
    "pb:build": "cd pb-tools && go build -o ../pb/pb-custom",
    "pb:import-all": "cd pb && ./pb-custom import-all-data",
    "ut:import-users": "cd pb && ./pb-custom import-users",
    "ut:import-cities": "cd pb && ./pb-custom import-cities",
    "ut:import-events": "cd pb && ./pb-custom import-events",
    "ut:import-sponsors": "cd pb && ./pb-custom import-sponsors",
    "ut:import": "cd pb && ./pb-custom import-all-data && ./pb-custom import-users && ./pb-custom import-cities && ./pb-custom import-events && ./pb-custom import-sponsors"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.4",
    "@astrojs/vue": "^7.0.2",
    "@element-plus/icons-vue": "^2.3.2",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@hcaptcha/vue3-hcaptcha": "^1.3.0",
    "@jota-one/i36n": "^3.0.0",
    "@plausible-analytics/tracker": "^0.4.6",
    "@tailwindcss/vite": "^4.3.3",
    "@vueuse/core": "^14.4.0",
    "astro": "^7.2.4",
    "dayjs": "^1.11.23",
    "element-plus": "^2.14.5",
    "papaparse": "^5.6.0",
    "pocketbase": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.41",
    "vue-multiselect": "^3.5.0",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/google.maps": "^3.65.5",
    "@types/node": "^24.13.3",
    "@types/papaparse": "^5.5.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^0.25.0",
    "postcss": "^8.5.26",
    "postcss-custom-media": "^12.0.1",
    "postcss-nested": "^7.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "volta": {
    "node": "24.11.1"
  }
}
