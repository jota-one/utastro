{
  "name": "ut-astro",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db": "cd pb && ./pocketbase serve --http=127.0.0.1:8091",
    "test:e2e": "bash tests/e2e/run.sh",
    "test:e2e:ui": "bash tests/e2e/run.sh --ui",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --write",
    "migrate:down": "cd pb && ./pocketbase migrate down",
    "migrate:up": "cd pb && ./pocketbase migrate up",
    "pb:build": "cd pb-tools && go build -o ../pb/pb-custom",
    "pb:import-all": "cd pb && ./pb-custom import-all-data",
    "ut:import-users": "cd pb && ./pb-custom import-users"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "@astrojs/vue": "^7.0.1",
    "@element-plus/icons-vue": "^2.3.2",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@hcaptcha/vue3-hcaptcha": "^1.3.0",
    "@jota-one/i36n": "^3.0.0",
    "@plausible-analytics/tracker": "^0.4.5",
    "@tailwindcss/vite": "^4.3.1",
    "@vueuse/core": "^14.3.0",
    "astro": "^7.0.6",
    "dayjs": "^1.11.21",
    "element-plus": "^2.14.2",
    "pocketbase": "^0.27.0",
    "tailwindcss": "^4.3.1",
    "vue": "^3.5.38",
    "vue-multiselect": "^3.5.0",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/google.maps": "^3.65.1",
    "@types/node": "^24.13.2",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "postcss": "^8.5.15",
    "postcss-custom-media": "^12.0.1",
    "postcss-nested": "^7.0.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.3"
  },
  "volta": {
    "node": "24.11.1"
  }
}
