---
import PageLayout from '@layouts/PageLayout.astro'
import ActivationPage from '@components/pages/ActivationPage.vue'
import { LANGS } from '@/routes'
import type { LangCode } from '@/routes'

export function getStaticPaths() {
  return LANGS.map(lang => ({ params: { lang }, props: { lang } }))
}

const { lang } = Astro.props as { lang: LangCode }
---

<PageLayout {lang}>
  <ActivationPage client:only="vue" />
</PageLayout>
