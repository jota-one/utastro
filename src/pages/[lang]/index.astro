---
import SiteLayout from '@layouts/SiteLayout.astro'
import Hero from '@components/content/Hero.vue'
import TextOn2Columns from '@/components/content/TextOn2Columns.vue'
import ContentBlockSpace from '@components/content/BlockSpace.vue'
import ContentBlockTitle from '@components/content/BlockTitle.vue'
import SessionsView from '@/components/content/Sessions.vue'
import ArrowLink from '@/components/ArrowLink.vue'
import Teasers from '@components/Teasers.vue'
import { LANGS, getPath } from '@/routes'
import type { LangCode } from '@/routes'
import type { Teaser } from '@/types'

export function getStaticPaths() {
  return LANGS.map(lang => ({ params: { lang }, props: { lang } }))
}

const { lang } = Astro.props as { lang: LangCode }

const heroContent: Record<LangCode, {
  headlineTextLines: string[]
  headlineHighlightTextLines: string[]
  subscribeButtonText: string
  vignetteText: string
}> = {
  fr: {
    headlineTextLines: ['Marche et exercices', 'en plein air'],
    headlineHighlightTextLines: ['pour tous'],
    subscribeButtonText: 'Inscris-toi!',
    vignetteText: 'Gratuit!',
  },
  de: {
    headlineTextLines: ['Outdoor Bewegung', 'und laufen'],
    headlineHighlightTextLines: ['für alle'],
    subscribeButtonText: 'Melde dich an!',
    vignetteText: 'Frei!',
  },
  en: {
    headlineTextLines: ['Outdoor walking', 'and workout'],
    headlineHighlightTextLines: ['for all'],
    subscribeButtonText: 'Subscribe now!',
    vignetteText: 'Free!',
  },
}

const sessionsTitles: Record<LangCode, string> = {
  fr: 'Prochaines sessions',
  de: 'Nächste Sessions',
  en: 'Next sessions',
}

const allSessionsLabels: Record<LangCode, string> = {
  fr: 'Toutes les sessions',
  de: 'Alle Sessions',
  en: 'All sessions',
}

const subscriptionPath = getPath('subscription', lang)
const coachFormPath = getPath('coach-subscription-form', lang)

const coachTeasers: Teaser[] = lang === 'fr' ? [
  {
    tags: [{ id: '1', label: 'Job' }],
    title: 'Recherche coaches',
    description: "<b>T'es sympa? Motivant? Souriant?</b><p>Alors rejoins-nous pour faire bouger la Suisse!</p>",
    link: { href: coachFormPath, label: 'Envoie ton CV' },
    displayTargets: [],
  },
] : []

const textColumns = {
  column1: '<p><b>Urban Training</b> te propose des cours <b>gratuits</b> alliant marche et exercices encadrés par un coach.</p><p>Cours libre <b>dès 16 ans</b></p>',
  column2: '<p>Pour y participer, choisis la ville, remplis le questionnaire santé et rendez-vous au lieu indiqué en tenue de sport.</p><p><b>Attention!</b> Pas de vestiaire ou de lieu pour déposer tes affaires.</p><p><b>Les cours Urban Training ont lieux par tous les temps!</b></p>',
}
---

<SiteLayout {lang}>
  <Hero client:only="vue" {...heroContent[lang]} />
  {lang === 'fr' && (
    <TextOn2Columns column1={textColumns.column1} column2={textColumns.column2} />
  )}
  <ContentBlockSpace size='half' />
  <ContentBlockTitle text={sessionsTitles[lang]} />
  <SessionsView client:only="vue" asideType="facebookWidget" initialDateRangeSize="week" listMax={10} />
  <ContentBlockSpace size='half' />
  <div class="all-sessions-link">
    <ArrowLink as-button href={subscriptionPath} label={allSessionsLabels[lang]} />
  </div>
  <ContentBlockSpace size='half' />
  <Teasers client:only="vue" teasers={coachTeasers} />
</SiteLayout>

<style>
.all-sessions-link {
  display: flex;
  justify-content: center;
}
</style>
