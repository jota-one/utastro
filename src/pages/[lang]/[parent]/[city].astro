---
export const prerender = false

import SiteLayout from '@layouts/SiteLayout.astro'
import PageLayout from '@layouts/PageLayout.astro'
import ContentBlockTitle from '@components/content/BlockTitle.vue'
import ContentBlockSpace from '@components/content/BlockSpace.vue'
import Map from '@/components/content/Map.vue'
import SessionsView from '@/components/content/Sessions.vue'
import ArrowLink from '@/components/ArrowLink.vue'
import SubscriptionFormPage from '@components/pages/SubscriptionFormPage.astro'
import { getPath, LANGS } from '@/routes'
import { pb } from '@/pb'
import type { LangCode } from '@/routes'
import type { City, Coords } from '@/types'

const { lang, parent, city: citySlug } = Astro.params as {
  lang: LangCode
  parent: string
  city: string
}

if (!LANGS.includes(lang)) {
  return Astro.redirect('/fr')
}

const subscriptionPath = getPath('subscription', lang)
const expectedParent = subscriptionPath.replace(`/${lang}/`, '')

if (parent !== expectedParent) {
  return new Response(null, { status: 404 })
}

// [parent]/[city] is more specific than [...slug] in Astro's router, so it
// intercepts sub-pages like /fr/inscription/formulaire. Detect and render them.
const subscriptionFormSlug = getPath('subscription-form', lang).split('/').pop()!
const isSubscriptionForm = citySlug === subscriptionFormSlug

let city: City | undefined = undefined
if (!isSubscriptionForm) {
  try {
    const record = await pb.collection('ut_cities').getFirstListItem(
      `slug="${citySlug}" && enabled=true`,
      { fields: 'id,label,slug,coords' },
    )
    const [lat, lng] = (record.coords || '').split(',').map(Number)
    city = {
      id: record.id,
      label: record.label,
      slug: record.slug,
      coords: [lat || 0, lng || 0] as Coords,
      sponsors: [],
    }
  } catch {
    return new Response(null, { status: 404 })
  }
}

const pageTitles: Record<LangCode, string> = {
  fr: `Prochaines sessions à ${city?.label}`,
  de: `Nächste Sessions in ${city?.label}`,
  en: `Next sessions in ${city?.label}`,
}

const backLinkLabels: Record<LangCode, string> = {
  fr: 'Toutes les sessions',
  de: 'Alle Sessions',
  en: 'All sessions',
}
---

{isSubscriptionForm ? (
  <PageLayout {lang}>
    <SubscriptionFormPage {lang} />
  </PageLayout>
) : (
<SiteLayout {lang}>
  <ContentBlockTitle text={pageTitles[lang]} />
  <Map client:only="vue" city={city} backLink={{label: "Toutes les villes", href: "/fr/inscription"}} />
  <ContentBlockSpace size="half" />
  <SessionsView client:only="vue" asideType="citySubscription" city={city} />
  <ContentBlockSpace size="half" />
  <div class="back-link">
    <ArrowLink reverse as-button href={subscriptionPath} label={backLinkLabels[lang]} />
  </div>
  <ContentBlockSpace size="half" />
</SiteLayout>
)}

<style>
.maps-link {
  padding-top: 1rem;
}

.back-link {
  display: flex;
  justify-content: center;
}
</style>
