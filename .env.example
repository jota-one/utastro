# Local development only — put these in .env.local, never in .env: the build
# would compile them in, and every deployed site would talk to that server.
# Deployed sites reach PocketBase and Astro on their own domain.
PUBLIC_PB_BASE_URI=http://127.0.0.1:8091
PUBLIC_ASTRO_BASE_URI=http://127.0.0.1:4321

# API Configuration
PUBLIC_API_PREFIX=/api/custom/auth

# Roles
PUBLIC_ROLE_ADMIN=admin
PUBLIC_ROLE_STAFF=staff

# HCaptcha (set to true to enable)
PUBLIC_HCAPTCHA_ENABLED=false
PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key-here

# Feature Flags
# Clickable sponsor logos on city pages (set to true to enable)
PUBLIC_SPONSOR_LINKS=false
