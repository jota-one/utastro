# App base URL — set to your local Astro dev server when developing
# Used by PocketBase to build links in verification and password reset emails
PUBLIC_ASTRO_BASE_URI=http://localhost:4321

# API Configuration
PUBLIC_API_PREFIX=/api/custom/auth

# Roles
PUBLIC_ROLE_ADMIN=admin
PUBLIC_ROLE_STAFF=staff

# HCaptcha (set to true to enable)
PUBLIC_HCAPTCHA_ENABLED=false
PUBLIC_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key-here
