# Astro SSR app
BASE_URL=http://localhost:4321

# PocketBase instance
PB_URL=http://localhost:8091

# Email catcher (Mailpit) — needed for registration + password reset tests
# Install: brew install mailpit
# Then configure PocketBase SMTP: host=localhost port=1025 (no auth)
MAILPIT_URL=http://localhost:8025

# Test account (must exist in the DB). It must be an admin or superadmin:
# specs use it to create and delete their own throwaway accounts and sessions
TEST_MEMBER_EMAIL=admin@example.com
TEST_MEMBER_PASSWORD=changeme

# A city slug that exists in the DB (e.g. "lausanne")
TEST_CITY_SLUG=
