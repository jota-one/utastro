# Astro SSR app
BASE_URL=http://localhost:4321

# PocketBase instance
PB_URL=http://localhost:8091

# Email catcher (Mailpit) — needed for registration + password reset tests
# Install: brew install mailpit
# Then configure PocketBase SMTP: host=localhost port=1025 (no auth)
MAILPIT_URL=http://localhost:8025

# Member test account (must exist in the DB)
TEST_MEMBER_EMAIL=member@example.com
TEST_MEMBER_PASSWORD=changeme

# Additional members for concurrent tests (3 users racing for the last spot)
TEST_MEMBER_2_EMAIL=member2@example.com
TEST_MEMBER_2_PASSWORD=changeme
TEST_MEMBER_3_EMAIL=member3@example.com
TEST_MEMBER_3_PASSWORD=changeme

# A future event open for subscriptions (not full, start_date in the future)
TEST_EVENT_ID_OPEN=

# An event that is full (subscription_count >= max_subscriptions)
TEST_EVENT_ID_FULL=

# A past event (start_date in the past)
TEST_EVENT_ID_PAST=

# An event with exactly 1 spot left — for concurrent race test
# Reset manually in PocketBase admin before running 03-concurrent.spec.ts
TEST_EVENT_ID_LAST_SPOT=

# A city slug that exists in the DB (e.g. "lausanne")
TEST_CITY_SLUG=
